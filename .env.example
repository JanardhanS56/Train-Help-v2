# ==============================================================================
# TravelRescue (Train-Help) Environment Variables
# ==============================================================================

# AI Assistant Provider Configuration
# Supported providers: groq | openrouter | nvidia | mock
AI_PROVIDER=groq
AI_API_KEY=

# Optional model override (defaults per provider):
# Groq: llama-3.3-70b-versatile or mixtral-8x7b-32768
# OpenRouter: meta-llama/llama-3.3-70b-instruct
# NVIDIA NIM: meta/llama-3.3-70b-instruct
AI_MODEL=llama-3.3-70b-versatile

# Optional custom base URL (overrides default provider endpoints)
# AI_BASE_URL=https://api.groq.com/openai/v1

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared API rate limiting (required in production; optional for local development)
# Use the private redis:// or rediss:// connection URL from your Redis provider.
REDIS_URL=

